# Raspberry Pi hardware runtime template.
#
# Copy this file to configs/raspi_runtime.env on the Raspberry Pi before any
# hardware experiment. Production target OS is Raspberry Pi OS 64-bit standard
# with desktop, not Ubuntu and not Lite. This profile is intentionally
# fail-closed: it connects to the Pixhawk and can run the mission loop in
# dry-run mode, but it does not enable the C920 detector or send commands by
# default.

# Pixhawk over USB serial. If heartbeat fails and Linux created a second ACM
# device, copy this template locally and change to /dev/ttyACM1.
MAVLINK_CONNECTION="/dev/ttyACM0"
MAVLINK_BAUD="115200"

# Hardware detector mode exists as a dry-run-capable path, but keep
# DETECTOR=none until camera preview, class filtering, and diagnostics are
# validated on the Raspberry Pi. Switch to DETECTOR="opencv-yolo" only after
# that validation.
DETECTOR="none"

# Logitech C920/OpenCV camera settings. These are requests to the camera driver;
# confirm the actual frame line in diagnostics before tuning visual gains.
OPENCV_CAMERA_SOURCE="0"
OPENCV_CAMERA_BACKEND="v4l2"
OPENCV_CAMERA_WIDTH="640"
OPENCV_CAMERA_HEIGHT="480"
OPENCV_CAMERA_FPS="30"
OPENCV_CAMERA_READ_TIMEOUT="0.05"
OPENCV_CAMERA_OPEN_RETRY="1.0"
OPENCV_DETECTION_STALE="0.75"
OPENCV_DIAGNOSTICS_WINDOW="1"

# Production model target is NCNN for Raspberry Pi 5 inference. Export from the
# .pt model with:
#   python scripts/export_yolo_ncnn.py --model models/gate_yolov8n_best.pt
#
# Do not enable this model path for flight until OpenCV camera diagnostics prove
# the selected target is correct.
# YOLO_MODEL_PATH="${REPO_ROOT}/models/gate_yolov8n_best_ncnn_model"
YOLO_IMGSZ="640"
YOLO_GATE_CLASS_NAMES="Goals-Detection"
YOLO_GATE_CLASS_IDS="3"
YOLO_DEVICE="cpu"

# Safety default: 0 means no MAVLink motion commands are sent.
SEND_COMMANDS="0"

# Keep the same loop/config shape as simulation so the mission state machine is
# exercised through the same runtime path.
LOOP_HZ="20"
MAX_RUNTIME="180"
MAVLINK_HEARTBEAT_STALE="3.0"
MAVLINK_LOCAL_POSITION_STALE="1.0"
COMMAND_ACK_REQUIRED="1"
COMMAND_ACK_TIMEOUT="1.0"
COMMAND_ACK_MAX_RETRIES="2"
# Optional structured runtime log. Leave empty/commented to disable.
# AUTONOMY_LOG_JSONL="${REPO_ROOT}/logs/raspi-dry-run.jsonl"
COURSE_FORWARD_X="1.0"
COURSE_FORWARD_Y="0.0"

# Hardware notes:
# - Target OS: Raspberry Pi OS 64-bit standard with desktop.
# - Production inference target: NCNN-exported YOLO model.
# - ArduPilot EKF owns GPS/rangefinder/optical-flow fusion.
# - The companion consumes fused LOCAL_POSITION_NED telemetry.
# - Do not set SEND_COMMANDS=1 until a hardware safety runbook is followed.
